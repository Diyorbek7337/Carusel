# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-your-token-here
# Vaqtinchalik fayllar papkasi (ixtiyoriy)
DOWNLOAD_DIR=downloads
# Telegram Bot API cheklovi 50 MB (o'z Local Bot API serveringiz bo'lsa 2000 qilishingiz mumkin)
MAX_FILE_MB=50
# Local Bot API server manzili (ixtiyoriy), masalan: http://localhost:8081
TELEGRAM_API_URL=
# Instagram/Facebook uchun cookies fayli (ixtiyoriy, Netscape formatida)
COOKIES_FILE=
